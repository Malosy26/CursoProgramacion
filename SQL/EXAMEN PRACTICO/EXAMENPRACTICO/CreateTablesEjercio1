



/*
Restaurante: tendrá nombre, dirección, teléfono y email
*/
CREATE TABLE Restaurante (
    id_restaurante SERIAL PRIMARY KEY,
    nombre VARCHAR(70) NOT NULL,
    direccion VARCHAR(100) NOT NULL,
    telefono VARCHAR(13) NOT NULL,
    email VARCHAR(100) NOT NULL
);

--Cliente: tendrá nombre, dirección, teléfono y email.
CREATE TABLE Cliente (
    id_cliente SERIAL PRIMARY KEY,
    nombre VARCHAR(70) NOT NULL,
    direccion VARCHAR(100) NOT NULL,
    telefono VARCHAR(13) NOT NULL,
    email VARCHAR(100) NOT NULL
);

--Rider (repartidor): tendrá nombre, teléfono y matrícula del vehículo.
CREATE TABLE Rider (
    id_rider SERIAL PRIMARY KEY,
    nombre VARCHAR(70) NOT NULL,
    telefono VARCHAR(13) NOT NULL,
    matricula_vehiculo VARCHAR(7) NOT NULL
	-- Entiendo que una matricula tiene 4 numero y 3 letras
);


CREATE TABLE Item (
    id_item SERIAL PRIMARY KEY,
    id_restaurante INT NOT NULL,
    nombre VARCHAR(70) NOT NULL,
    precio DECIMAL(10, 2) NOT NULL,
    FOREIGN KEY (id_restaurante) REFERENCES Restaurante(id_restaurante)
);

--Cada pedido tiene un número de orden único, fecha y estado.
CREATE TABLE Pedido (
    id_pedido SERIAL PRIMARY KEY,
    numero_orden INT UNIQUE NOT NULL,
    fecha DATE NOT NULL,
    estado VARCHAR(50) NOT NULL,
    id_cliente INT NOT NULL,
    id_restaurante INT NOT NULL,
    id_rider INT NOT NULL,
    FOREIGN KEY (id_cliente) REFERENCES Cliente(id_cliente),
    FOREIGN KEY (id_restaurante) REFERENCES Restaurante(id_restaurante),
    FOREIGN KEY (id_rider) REFERENCES Rider(id_rider)
);


CREATE TABLE LineaPedido (
    id_linea SERIAL PRIMARY KEY,
    id_pedido INT NOT NULL,
    id_item INT NOT NULL,
	plato 	VARCHAR(50) NOT NULL,
    cantidad INT NOT NULL,
    precio_unitario DECIMAL(10, 2) NOT NULL,
    FOREIGN KEY (id_pedido) REFERENCES Pedido(id_pedido),
    FOREIGN KEY (id_item) REFERENCES Item(id_item)
);
